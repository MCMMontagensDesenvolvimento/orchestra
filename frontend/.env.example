VITE_APP_NAME=Orchestra
# Use local/development for local runs. Staging and production prohibit mock mode.
VITE_APP_ENV=local
# Real Orchestra backend used whenever mock mode is disabled.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Safe default. Set true only for an explicit local/test/prototype session.
VITE_USE_MOCKS=false
VITE_MOCK_DELAY_MS=400
VITE_MOCK_SCENARIO=success
# Legacy placeholder: this variable does not currently enable a functional demo mode.
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_PWA=false
VITE_DEFAULT_LOCALE=pt-BR
VITE_DEFAULT_TIMEZONE=America/Recife
