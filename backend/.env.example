NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://orchestra:orchestra@db:5432/orchestra
FRONTEND_ORIGIN=http://localhost:5173

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=86400
COOKIE_NAME=orchestra_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=debug

DEV_LOGIN_ENABLED=true

ORCHESTRA_ENV=local
ORCHESTRA_SEED_DEMO=false

POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra

MICROSOFT_SSO_ENABLED=true
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOWED_TENANT_IDS=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAINS=mcmmontagens.com.br,mcm.eng.br
MICROSOFT_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
MICROSOFT_SSO_AUTO_LINK_BY_EMAIL=false

LLM_PROVIDERS_ENABLED=true
LLM_DEFAULT_PROVIDER=local_deterministic
LLM_EXECUTION_ENABLED=true
LLM_PROVIDER_EXECUTION_ENABLED=true
LLM_PROVIDER_TIMEOUT_MS=30000
LLM_MAX_INPUT_PREVIEW_CHARS=500
LLM_MAX_OUTPUT_PREVIEW_CHARS=800
LLM_STORE_RAW_PROMPTS=false
LLM_STORE_RAW_OUTPUTS=false
LLM_TEST_GENERATION_ENABLED=true
LLM_ALLOW_TEST_GENERATION=true

EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=disabled
EMBEDDINGS_EXECUTION_ENABLED=false
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSION=
EMBEDDINGS_TIMEOUT_MS=10000
EMBEDDINGS_MAX_INPUT_CHARS=8000
EMBEDDINGS_MAX_BATCH_SIZE=16
EMBEDDINGS_STORE_RAW_INPUTS=false
EMBEDDINGS_STORE_RAW_OUTPUTS=false

OPENAI_ENABLED=true
OPENAI_PROVIDER_ENABLED=true
OPENAI_EXECUTION_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EXECUTION_ENABLED=false

ANTHROPIC_ENABLED=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_EXECUTION_ENABLED=false

EMBEDDING_PROVIDER=
VECTOR_DATABASE_URL=
MCP_SERVER_URL=
AI_RUNTIME_URL=
AI_TRACE_ENABLED=false
AI_TOKEN_BUDGET_DAILY=
AI_COST_ALERT_THRESHOLD=

RUNTIME_PROVIDER=local
RUNTIME_ADAPTER_ENABLED=true
RUNTIME_DEFAULT_TIMEOUT_MS=15000
RUNTIME_REQUEST_TIMEOUT_MS=15000
RUNTIME_REQUIRE_PRECHECK=true
RUNTIME_ALLOW_PROVIDER_FALLBACK=false
RUNTIME_ALLOW_EXTERNAL_TOOLS=false

CHAT_CONTEXT_ENABLED=true
CHAT_CONTEXT_MAX_MESSAGES=12
CHAT_CONTEXT_MAX_MESSAGE_CHARS=1200
CHAT_CONTEXT_MAX_TOTAL_CHARS=6000

AGNO_ENABLED=false
AGNO_EXECUTION_ENABLED=false
AGNO_BASE_URL=
AGNO_API_KEY=
AGNO_TIMEOUT_MS=15000
AGNO_HEALTHCHECK_ENABLED=false
AGNO_HEALTH_PATH=/health
AGNO_CAPABILITIES_PATH=/capabilities
AGNO_EXECUTE_PATH=/runs
AGNO_REQUIRE_SANDBOX=true
AGNO_ALLOW_EXTERNAL_TOOLS=false
AGNO_ALLOW_REMOTE_MCP=false
AGNO_SEND_RAG_CONTEXT=true
AGNO_SEND_MCP_TOOL_DESCRIPTORS=true
AGNO_MAX_INPUT_PREVIEW_CHARS=500
AGNO_MAX_OUTPUT_PREVIEW_CHARS=800

AGNO_RUNTIME_HTTP_ENABLED=false
AGNO_RUNTIME_HTTP_BASE_URL=http://127.0.0.1:8091
AGNO_RUNTIME_HTTP_TIMEOUT_MS=15000
AGNO_RUNTIME_HTTP_REQUIRE_SECURITY_KEY=false
AGNO_RUNTIME_HTTP_SECURITY_KEY=
