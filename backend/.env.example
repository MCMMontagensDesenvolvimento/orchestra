NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://orchestra:orchestra@db:5432/orchestra
FRONTEND_ORIGIN=http://localhost:5173

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=86400
COOKIE_NAME=orchestra_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=debug

POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra

# Future backend-only AI/provider secrets. Do not expose in frontend.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=
MCP_SERVER_URL=
MCP_SERVER_API_KEY=
AI_RUNTIME_URL=
AI_RUNTIME_API_KEY=
AI_TRACE_ENABLED=false
AI_TOKEN_BUDGET_DAILY=
AI_COST_ALERT_THRESHOLD=
