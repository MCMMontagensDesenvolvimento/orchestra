  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant          Assistant        @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantVersion   AssistantVersion? @relation(fields: [assistantVersionId], references: [id], onDelete: SetNull)
  agentRun           AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdBy          User             @relation("RagQueryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  results            RagQueryResult[]

  @@index([tenantId])
  @@index([workspaceId])
  @@index([assistantId])
  @@index([assistantVersionId])
  @@index([agentRunId])
  @@index([createdById])
  @@index([status])
  @@index([mode])
  @@index([requestId])
  @@index([traceId])
  @@index([createdAt])
  @@map("rag_queries")
}

model RagQueryResult {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  workspaceId       String                    @map("workspace_id") @db.Uuid
  ragQueryId        String                    @map("rag_query_id") @db.Uuid
  knowledgeBaseId   String                    @map("knowledge_base_id") @db.Uuid
  documentId        String                    @map("document_id") @db.Uuid
  chunkId           String                    @map("chunk_id") @db.Uuid
  sourceReferenceId String?                   @map("source_reference_id") @db.Uuid
  rank              Int
  score             Float
  matchType         String                    @default("content") @map("match_type")
  excerpt           String
  citationLabel     String                    @map("citation_label")
  metadata          Json?
  createdAt         DateTime                  @default(now()) @map("created_at")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ragQuery          RagQuery                  @relation(fields: [ragQueryId], references: [id], onDelete: Cascade)
  knowledgeBase     KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document          KnowledgeDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk             KnowledgeChunk            @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sourceReference   KnowledgeSourceReference? @relation(fields: [sourceReferenceId], references: [id], onDelete: SetNull)

  @@unique([ragQueryId, rank])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([ragQueryId])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@index([chunkId])
  @@index([sourceReferenceId])
  @@index([rank])
  @@index([createdAt])
  @@map("rag_query_results")
}

model AgentRunEvent {
  id          String    @id @default(uuid()) @db.Uuid
  agentRunId  String    @map("agent_run_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  type        String
  sequence    Int
  status      String?
  message     String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  agentRun    AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, sequence])
  @@index([agentRunId])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
  @@map("agent_run_events")
}

model McpToolCall {
