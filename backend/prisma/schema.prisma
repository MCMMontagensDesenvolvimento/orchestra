generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String                      @unique
  status                     String                      @default("active")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  deletedAt                  DateTime?                   @map("deleted_at")
  workspaces                 Workspace[]
  users                      User[]
  roles                      Role[]
  settings                   Setting[]
  auditLogs                  AuditLog[]
  assistants                 Assistant[]
  assistantPublications      AssistantPublication[]
  assistantFeedbacks         AssistantFeedback[]
  assistantTestResults       AssistantTestResult[]
  assistantApprovals         AssistantApprovalRequest[]
  assistantExecutionPolicies AssistantExecutionPolicy[]
  knowledgeBases             KnowledgeBase[]
  knowledgeDocuments         KnowledgeDocument[]
  knowledgeDataSources       KnowledgeDataSource[]
  knowledgeChunks            KnowledgeChunk[]
  knowledgeSourceReferences  KnowledgeSourceReference[]
  knowledgeIngestionJobs     KnowledgeIngestionJob[]
  knowledgeIngestionEvents   KnowledgeIngestionEvent[]
  knowledgePolicies          KnowledgePolicy[]
  assistantKnowledgeBindings AssistantKnowledgeBinding[]
  mcpServers                 McpServer[]
  mcpTools                   McpTool[]
  mcpResources               McpResource[]
  mcpPrompts                 McpPrompt[]
  mcpToolPolicies            McpToolPolicy[]
  assistantMcpBindings       AssistantMcpBinding[]
  providerConfigs            ProviderConfig[]
  usageRecords               UsageRecord[]
  agentRuns                  AgentRun[]
  agentRunEvents             AgentRunEvent[]
  ragQueries                 RagQuery[]
  ragQueryResults            RagQueryResult[]
  mcpToolCalls               McpToolCall[]
  mcpToolCallEvents          McpToolCallEvent[]

  @@map("tenants")
}

model Workspace {
  id                         String                      @id @default(uuid()) @db.Uuid
  tenantId                   String                      @map("tenant_id") @db.Uuid
  name                       String
  slug                       String
  description                String?
  status                     String                      @default("active")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  deletedAt                  DateTime?                   @map("deleted_at")
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships                WorkspaceMembership[]
  settings                   Setting[]
  auditLogs                  AuditLog[]
  assistants                 Assistant[]
  assistantPublications      AssistantPublication[]
  assistantFeedbacks         AssistantFeedback[]
  assistantTestResults       AssistantTestResult[]
  assistantApprovals         AssistantApprovalRequest[]
  assistantExecutionPolicies AssistantExecutionPolicy[]
  knowledgeBases             KnowledgeBase[]
  knowledgeDocuments         KnowledgeDocument[]
  knowledgeDataSources       KnowledgeDataSource[]
  knowledgeChunks            KnowledgeChunk[]
  knowledgeSourceReferences  KnowledgeSourceReference[]
  knowledgeIngestionJobs     KnowledgeIngestionJob[]
  knowledgeIngestionEvents   KnowledgeIngestionEvent[]
  knowledgePolicies          KnowledgePolicy[]
  assistantKnowledgeBindings AssistantKnowledgeBinding[]
  mcpServers                 McpServer[]
  mcpTools                   McpTool[]
  mcpResources               McpResource[]
  mcpPrompts                 McpPrompt[]
  mcpToolPolicies            McpToolPolicy[]
  assistantMcpBindings       AssistantMcpBinding[]
  agentRuns                  AgentRun[]
  agentRunEvents             AgentRunEvent[]
  ragQueries                 RagQuery[]
  ragQueryResults            RagQueryResult[]
  mcpToolCalls               McpToolCall[]
  mcpToolCallEvents          McpToolCallEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("workspaces")
}

model User {
  id                                String                      @id @default(uuid()) @db.Uuid
  tenantId                          String                      @map("tenant_id") @db.Uuid
  email                             String                      @unique
  name                              String
  passwordHash                      String?                     @map("password_hash")
  status                            String                      @default("active")
  lastLoginAt                       DateTime?                   @map("last_login_at")
  createdAt                         DateTime                    @default(now()) @map("created_at")
  updatedAt                         DateTime                    @updatedAt @map("updated_at")
  deletedAt                         DateTime?                   @map("deleted_at")
  tenant                            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                             UserRole[]
  memberships                       WorkspaceMembership[]
  sessions                          Session[]
  auditLogs                         AuditLog[]                  @relation("ActorAuditLogs")
  assistants                        Assistant[]                 @relation("AssistantCreator")
  versions                          AssistantVersion[]          @relation("AssistantVersionCreator")
  publishedAssistantPublications    AssistantPublication[]      @relation("AssistantPublicationPublisher")
  unpublishedAssistantPublications  AssistantPublication[]      @relation("AssistantPublicationUnpublisher")
  requestedAssistantApprovals       AssistantApprovalRequest[]  @relation("AssistantApprovalRequester")
  decidedAssistantApprovals         AssistantApprovalRequest[]  @relation("AssistantApprovalDecider")
  updatedAssistantExecutionPolicies AssistantExecutionPolicy[]  @relation("AssistantExecutionPolicyUpdater")
  assistantShares                   AssistantShare[]            @relation("AssistantShareCreator")
  assistantFeedbacks                AssistantFeedback[]         @relation("AssistantFeedbackUser")
  assistantTestResults              AssistantTestResult[]       @relation("AssistantTestResultTester")
  conversations                     Conversation[]
  messages                          ConversationMessage[]
  agentRuns                         AgentRun[]                  @relation("AgentRunRequester")
  toolCalls                         ToolCall[]
  ownedKnowledgeBases               KnowledgeBase[]             @relation("KnowledgeBaseOwner")
  createdKnowledgeDocuments         KnowledgeDocument[]         @relation("KnowledgeDocumentCreator")
  createdKnowledgeDataSources       KnowledgeDataSource[]       @relation("KnowledgeDataSourceCreator")
  createdKnowledgeIngestionJobs     KnowledgeIngestionJob[]     @relation("KnowledgeIngestionJobCreator")
  createdAssistantKnowledgeBindings AssistantKnowledgeBinding[] @relation("AssistantKnowledgeBindingCreator")
  createdMcpServers                 McpServer[]                 @relation("McpServerCreator")
  createdAssistantMcpBindings       AssistantMcpBinding[]       @relation("AssistantMcpBindingCreator")
  ragQueries                        RagQuery[]                  @relation("RagQueryCreator")
  mcpToolCalls                      McpToolCall[]               @relation("McpToolCallRequester")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, workspaceId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model WorkspaceMembership {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  role        String    @default("member")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @map("session_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String?    @map("tenant_id") @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?    @map("entity_id")
  metadata    Json?
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  requestId   String?    @map("request_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?      @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([actorUserId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  key         String
  value       Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, key])
  @@index([tenantId])
  @@map("settings")
}

model Assistant {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @map("tenant_id") @db.Uuid
  workspaceId       String                      @map("workspace_id") @db.Uuid
  name              String
  description       String?
  status            String                      @default("draft")
  createdById       String                      @map("created_by_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  deletedAt         DateTime?                   @map("deleted_at")
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User                        @relation("AssistantCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions          AssistantVersion[]
  shares            AssistantShare[]
  publications      AssistantPublication[]
  feedbacks         AssistantFeedback[]
  testResults       AssistantTestResult[]
  approvalRequests  AssistantApprovalRequest[]
  executionPolicy   AssistantExecutionPolicy?
  conversations     Conversation[]
  agentRuns         AgentRun[]
  usageRecords      UsageRecord[]
  knowledgeBindings AssistantKnowledgeBinding[]
  mcpBindings       AssistantMcpBinding[]
  ragQueries        RagQuery[]
  mcpToolCalls      McpToolCall[]

  @@index([tenantId])
  @@index([workspaceId])
  @@index([status])
  @@map("assistants")
}

model AssistantVersion {
  id               String                     @id @default(uuid()) @db.Uuid
  assistantId      String                     @map("assistant_id") @db.Uuid
  version          String
  status           String                     @default("draft")
  displayName      String                     @map("display_name")
  description      String?
  instructions     String?
  modelProvider    String?                    @map("model_provider")
  modelName        String?                    @map("model_name")
  temperature      Decimal?                   @db.Decimal(4, 2)
  configuration    Json?
  createdById      String                     @map("created_by_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")
  publishedAt      DateTime?                  @map("published_at")
  archivedAt       DateTime?                  @map("archived_at")
  assistant        Assistant                  @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdBy        User                       @relation("AssistantVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publications     AssistantPublication[]
  feedbacks        AssistantFeedback[]
  testResults      AssistantTestResult[]
  approvalRequests AssistantApprovalRequest[]
  agentRuns        AgentRun[]
  ragQueries       RagQuery[]
  mcpToolCalls     McpToolCall[]

  @@unique([assistantId, version])
  @@index([assistantId])
  @@map("assistant_versions")
}

model AssistantShare {
  id                String    @id @default(uuid()) @db.Uuid
  assistantId       String    @map("assistant_id") @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  shareType         String    @map("share_type")
  targetId          String?   @map("target_id")
  targetType        String    @default("workspace") @map("target_type")
  targetUserId      String?   @map("target_user_id") @db.Uuid
  targetWorkspaceId String?   @map("target_workspace_id") @db.Uuid
  targetRoleId      String?   @map("target_role_id") @db.Uuid
  permission        String    @default("can_use")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  assistant         Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdBy         User?     @relation("AssistantShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assistantId])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([targetUserId])
  @@index([targetWorkspaceId])
  @@index([targetRoleId])
  @@map("assistant_shares")
}

model AssistantPublication {
  id                        String                     @id @default(uuid()) @db.Uuid
  tenantId                  String                     @map("tenant_id") @db.Uuid
  workspaceId               String                     @map("workspace_id") @db.Uuid
  assistantId               String                     @map("assistant_id") @db.Uuid
  assistantVersionId        String                     @map("assistant_version_id") @db.Uuid
  status                    String                     @default("active")
  publishedById             String                     @map("published_by_id") @db.Uuid
  publishedAt               DateTime                   @default(now()) @map("published_at")
  unpublishedById           String?                    @map("unpublished_by_id") @db.Uuid
  unpublishedAt             DateTime?                  @map("unpublished_at")
  rollbackFromPublicationId String?                    @map("rollback_from_publication_id") @db.Uuid
  rollbackReason            String?                    @map("rollback_reason")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant                 Assistant                  @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantVersion          AssistantVersion           @relation(fields: [assistantVersionId], references: [id], onDelete: Cascade)
  publishedBy               User                       @relation("AssistantPublicationPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  unpublishedBy             User?                      @relation("AssistantPublicationUnpublisher", fields: [unpublishedById], references: [id], onDelete: SetNull)
  rollbackFromPublication   AssistantPublication?      @relation("AssistantPublicationRollback", fields: [rollbackFromPublicationId], references: [id], onDelete: SetNull)
  rollbackPublications      AssistantPublication[]     @relation("AssistantPublicationRollback")
  approvalRequests          AssistantApprovalRequest[]
  agentRuns                 AgentRun[]

  @@index([tenantId])
  @@index([workspaceId])
  @@index([assistantId])
  @@index([assistantVersionId])
  @@index([status])
  @@index([publishedAt])
  @@map("assistant_publications")
}

model AssistantFeedback {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  workspaceId        String            @map("workspace_id") @db.Uuid
  assistantId        String            @map("assistant_id") @db.Uuid
  assistantVersionId String?           @map("assistant_version_id") @db.Uuid
  conversationId     String?           @map("conversation_id")
  messageId          String?           @map("message_id")
  userId             String            @map("user_id") @db.Uuid
  rating             String
  comment            String?
  createdAt          DateTime          @default(now()) @map("created_at")
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant          Assistant         @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantVersion   AssistantVersion? @relation(fields: [assistantVersionId], references: [id], onDelete: SetNull)
  user               User              @relation("AssistantFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([assistantId])
  @@index([assistantVersionId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("assistant_feedback")
}

model AssistantTestResult {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  assistantId        String           @map("assistant_id") @db.Uuid
  assistantVersionId String           @map("assistant_version_id") @db.Uuid
  testedById         String           @map("tested_by_id") @db.Uuid
  input              String
  expectedBehavior   String?          @map("expected_behavior")
  actualOutput       String           @map("actual_output")
  status             String
  score              Int?
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant          Assistant        @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantVersion   AssistantVersion @relation(fields: [assistantVersionId], references: [id], onDelete: Cascade)
  testedBy           User             @relation("AssistantTestResultTester", fields: [testedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([assistantId])
  @@index([assistantVersionId])
  @@index([testedById])
  @@index([status])
  @@index([createdAt])
  @@map("assistant_test_results")
}

model AssistantApprovalRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  workspaceId        String                @map("workspace_id") @db.Uuid
  assistantId        String                @map("assistant_id") @db.Uuid
  assistantVersionId String?               @map("assistant_version_id") @db.Uuid
  publicationId      String?               @map("publication_id") @db.Uuid
  requestedById      String                @map("requested_by_id") @db.Uuid
  decidedById        String?               @map("decided_by_id") @db.Uuid
  action             String
  status             String                @default("pending")
  reason             String?
  decisionReason     String?               @map("decision_reason")
  metadata           Json?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  decidedAt          DateTime?             @map("decided_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant          Assistant             @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantVersion   AssistantVersion?     @relation(fields: [assistantVersionId], references: [id], onDelete: SetNull)
  publication        AssistantPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  requestedBy        User                  @relation("AssistantApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy          User?                 @relation("AssistantApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([assistantId])
  @@index([assistantVersionId])
  @@index([publicationId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("assistant_approval_requests")
}

model AssistantExecutionPolicy {
  id                          String    @id @default(uuid()) @db.Uuid
  tenantId                    String    @map("tenant_id") @db.Uuid
  workspaceId                 String    @map("workspace_id") @db.Uuid
  assistantId                 String    @unique @map("assistant_id") @db.Uuid
  executionMode               String    @default("draft_test") @map("execution_mode")
  requiresApprovalToPublish   Boolean   @default(false) @map("requires_approval_to_publish")
  sandboxEnabled              Boolean   @default(true) @map("sandbox_enabled")
  sandboxRequiresAuth         Boolean   @default(true) @map("sandbox_requires_auth")
  sandboxAllowedForRoles      Json?     @map("sandbox_allowed_for_roles")
  sandboxBlocksExternalTools  Boolean   @default(true) @map("sandbox_blocks_external_tools")
  sandboxBlocksRealProviders  Boolean   @default(true) @map("sandbox_blocks_real_providers")
  sandboxLogsRequired         Boolean   @default(true) @map("sandbox_logs_required")
  sandboxCostLimitPlaceholder Decimal?  @map("sandbox_cost_limit_placeholder") @db.Decimal(12, 4)
  allowDraftTesting           Boolean   @default(true) @map("allow_draft_testing")
  allowPublishedExecution     Boolean   @default(false) @map("allow_published_execution")
  isExecutionEnabled          Boolean   @default(false) @map("is_execution_enabled")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  updatedById                 String?   @map("updated_by_id") @db.Uuid
  tenant                      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace                   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistant                   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  updatedBy                   User?     @relation("AssistantExecutionPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([executionMode])
  @@index([isExecutionEnabled])
  @@map("assistant_execution_policies")
}

model KnowledgeBase {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  workspaceId        String                      @map("workspace_id") @db.Uuid
  name               String
  description        String?
  status             String                      @default("active")
  visibility         String                      @default("workspace")
  dataClassification String                      @default("internal") @map("data_classification")
  ownerUserId        String?                     @map("owner_user_id") @db.Uuid
  metadata           Json?
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  deletedAt          DateTime?                   @map("deleted_at")
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner              User?                       @relation("KnowledgeBaseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  documents          KnowledgeDocument[]
  dataSources        KnowledgeDataSource[]
  chunks             KnowledgeChunk[]
  sourceReferences   KnowledgeSourceReference[]
  ingestionJobs      KnowledgeIngestionJob[]
  ingestionEvents    KnowledgeIngestionEvent[]
  bindings           AssistantKnowledgeBinding[]
  policies           KnowledgePolicy[]
  ragQueryResults    RagQueryResult[]

  @@index([tenantId])
  @@index([workspaceId])
  @@index([status])
  @@index([visibility])
  @@index([dataClassification])
  @@map("knowledge_bases")
}

