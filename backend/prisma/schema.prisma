  @@index([mcpServerId])
  @@index([mcpToolId])
  @@index([assistantMcpBindingId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([mode])
  @@index([riskLevelSnapshot])
  @@index([requestId])
  @@index([traceId])
  @@index([createdAt])
  @@map("mcp_tool_calls")
