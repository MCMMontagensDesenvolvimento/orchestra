COMPOSE_PROJECT_NAME=orchestra
TZ=America/Sao_Paulo

# Required by docker-compose.prod.yml. Copy this file to the ignored .env file
# and obtain secret values from the approved secret manager. Never commit them.
POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
ORCHESTRA_FRONTEND_IMAGE=orchestra-frontend:local
ORCHESTRA_BACKEND_IMAGE=orchestra-backend:local
ORCHESTRA_AGNO_BRIDGE_IMAGE=orchestra-agno-bridge:local

# Production runtime remains local and fail-closed unless the Agno profile is
# explicitly enabled with a shared bearer secret.
RUNTIME_PROVIDER=local
AGNO_RUNTIME_HTTP_ENABLED=false
AGNO_RUNTIME_HTTP_SECURITY_KEY=
AGNO_BRIDGE_EXECUTION_MODE=stub
AGNO_BRIDGE_PROVIDER=stub
AGNO_BRIDGE_ALLOWED_MODELS=

# MCP externo permanece desligado. A allowlist aceita origins HTTPS explícitas;
# o HTTP abaixo só vale para o demo local, com flag opt-in e nunca em production.
# Credenciais reais nunca pertencem aqui.
MCP_REMOTE_ENABLED=false
MCP_REMOTE_DISCOVERY_ENABLED=false
MCP_REMOTE_EXECUTION_ENABLED=false
MCP_REMOTE_READONLY_ENABLED=false
MCP_REMOTE_EGRESS_ALLOWLIST=
MCP_REMOTE_MAX_TIMEOUT_MS=5000
MCP_REMOTE_MAX_RESPONSE_BYTES=65536
MCP_REMOTE_REQUIRE_SECRET_REF=true
MCP_REMOTE_ALLOW_WRITE_TOOLS=false
MCP_REMOTE_ALLOW_INSECURE_LOCAL_DEMO=false
MCP_REMOTE_LOCAL_DEMO_ORIGIN=http://mcp-readonly-demo:8092
