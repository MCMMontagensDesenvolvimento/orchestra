COMPOSE_PROJECT_NAME=orchestra
TZ=America/Sao_Paulo

# Required by docker-compose.prod.yml. Copy this file to the ignored .env file
# and obtain secret values from the approved secret manager. Never commit them.
POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
ORCHESTRA_FRONTEND_IMAGE=orchestra-frontend:local
ORCHESTRA_BACKEND_IMAGE=orchestra-backend:local
ORCHESTRA_AGNO_BRIDGE_IMAGE=orchestra-agno-bridge:local

# Production runtime remains local and fail-closed unless the Agno profile is
# explicitly enabled with a shared bearer secret.
RUNTIME_PROVIDER=local
AGNO_RUNTIME_HTTP_ENABLED=false
AGNO_RUNTIME_HTTP_SECURITY_KEY=
AGNO_BRIDGE_EXECUTION_MODE=stub
AGNO_BRIDGE_PROVIDER=stub
AGNO_BRIDGE_ALLOWED_MODELS=
