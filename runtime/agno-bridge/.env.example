AGNO_BRIDGE_EXECUTION_MODE=stub
AGNO_BRIDGE_PROVIDER=stub

# static   = use only AGNO_BRIDGE_ALLOWED_MODELS
# provider = discover models from the configured provider
AGNO_BRIDGE_MODEL_DISCOVERY=static

# Empty in provider mode means all models returned by the provider.
# Filled means intersection: provider-discovered models ∩ this allowlist.
AGNO_BRIDGE_ALLOWED_MODELS=

# Preferred default when present in the resulting catalog.
AGNO_BRIDGE_DEFAULT_MODEL=

AGNO_BRIDGE_MODEL_DISCOVERY_CACHE_TTL_SECONDS=600
AGNO_BRIDGE_MODEL_DISCOVERY_TIMEOUT_MS=5000

AGNO_RUNTIME_HTTP_HOST=0.0.0.0
AGNO_RUNTIME_HTTP_PORT=8091
AGNO_RUNTIME_HTTP_REQUIRE_SECURITY_KEY=true
AGNO_RUNTIME_HTTP_SECURITY_KEY=
AGNO_RUNTIME_HTTP_RAG_CONTEXT_ENABLED=false
AGNO_RUNTIME_HTTP_TOOLS_ENABLED=false
AGNO_RUNTIME_HTTP_MAX_TOOL_CALLS=0
AGNO_RUNTIME_HTTP_TOOL_GATEWAY_ENABLED=false

ORCHESTRA_TOOL_GATEWAY_URL=

OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=

AGNO_TELEMETRY=false

