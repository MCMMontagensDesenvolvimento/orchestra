{
  "$schema": "orchestra.eval-suite.16s.v1",
  "suite": "corporate-readonly",
  "version": "16s.1",
  "cases": [
    {
      "id": "16s-corporate-disabled-001",
      "category": "corporate_readonly",
      "objective": "Manter o adapter corporativo read-only bloqueado por default.",
      "tags": ["corporate_readonly", "corporate_disabled_default"],
      "input": {
        "synthetic": true,
        "scenario": "corporate_disabled_default",
        "connector": {
          "enabled": false,
          "hostSafety": "public_approved",
          "secretRefConfigured": true
        }
      },
      "expectation": {
        "decision": "block_corporate_disabled",
        "mcpRemoteAllowed": false,
        "mcpRemoteBlocked": true,
        "toolExecutionAttempted": false,
        "blockedBeforeRuntime": true,
        "externalProviderCalled": false,
        "externalMcpCalled": false,
        "corporateServiceCalled": false,
        "rawContentLogged": false,
        "offlineOnly": true
      }
    },
    {
