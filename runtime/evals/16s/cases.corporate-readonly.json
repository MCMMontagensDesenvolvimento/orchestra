      "id": "16s-audit-safe-fields-009",
      "category": "corporate_readonly",
      "objective": "Permitir auditoria pós-run somente com a projeção técnica allowlistada.",
      "tags": ["corporate_readonly", "audit_query_no_raw_fields"],
      "input": {
        "synthetic": true,
        "scenario": "audit_query_no_raw_fields",
        "auditQuery": {
          "selectedFields": [
            "runId",
            "status",
            "externalMcpCalled",
            "simulated",
            "mcpRemoteAllowed",
            "mcpRemoteBlocked",
            "mcpRemoteBlockedReason",
            "mcpRemoteHost",
            "mcpRemoteToolId",
            "responseBytes",
            "latencyMs",
