    {
      "id": "16s-corporate-write-block-004",
      "category": "corporate_readonly",
      "objective": "Bloquear tool corporativa com nome ou operação de escrita.",
      "tags": ["corporate_readonly", "corporate_write_block", "mcp_write_block"],
      "input": {
        "synthetic": true,
        "scenario": "corporate_write_tool",
        "connector": {
          "enabled": true,
          "hostSafety": "public_approved",
          "secretRefConfigured": true
        },
        "tool": {
          "name": "corporate.status.delete",
          "operation": "delete",
          "readOnly": false,
          "riskLevel": "low"
        }
      },
      "expectation": {
        "decision": "block_write_tool",
        "mcpRemoteAllowed": false,
        "mcpRemoteBlocked": true,
        "mcpRemoteBlockedReason": "dangerous_operation",
        "toolExecutionAttempted": false,
        "blockedBeforeRuntime": true,
        "externalProviderCalled": false,
        "externalMcpCalled": false,
        "corporateServiceCalled": false,
        "rawContentLogged": false,
        "offlineOnly": true
      }
    },
    {
      "id": "16s-corporate-raw-leakage-005",
      "category": "corporate_readonly",
      "objective": "Manter payload corporativo bruto fora de metadata, audit e analytics.",
      "tags": ["corporate_readonly", "corporate_raw_payload", "raw_payload_leakage"],
      "input": {
        "synthetic": true,
        "scenario": "corporate_raw_payload",
        "connector": {
          "enabled": true,
          "hostSafety": "public_approved",
          "secretRefConfigured": true
        },
        "candidateMetadataFields": [
          "rawPrompt",
          "rawContext",
          "rawArgs",
          "rawOutput",
          "headers",
          "cookies",
          "Authorization",
          "secretRef",
          "apiKey",
          "responseScopeMode",
          "ragMode",
          "mcpRemoteAllowed",
          "usageLimitBlocked",
          "rawContentLogged"
        ]
      },
      "expectation": {
        "decision": "sanitize_raw_payload",
        "persistedMetadataFields": [
          "responseScopeMode",
          "ragMode",
          "mcpRemoteAllowed",
          "usageLimitBlocked",
          "rawContentLogged"
        ],
        "forbiddenMetadataFieldsAbsent": true,
        "blockedBeforeRuntime": false,
        "externalProviderCalled": false,
        "externalMcpCalled": false,
        "corporateServiceCalled": false,
        "rawContentLogged": false,
        "offlineOnly": true
      }
    },
