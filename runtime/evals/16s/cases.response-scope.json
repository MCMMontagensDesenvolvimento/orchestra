      "objective": "Manter knowledge_only fechado quando a base ficticia nao resolver a pergunta.",
      "tags": ["response_scope", "knowledge_only", "rag_grounding"],
      "input": {
        "synthetic": true,
        "scenario": "knowledge_only_no_match",
        "question": "Resuma o item ficticio Horizonte, que nao existe na base.",
