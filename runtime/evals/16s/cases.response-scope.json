        "externalMcpCalled": false,
        "corporateServiceCalled": false,
        "rawContentLogged": false,
        "offlineOnly": true
      }
    },
    {
      "id": "16s-response-scope-general-002",
      "category": "response_scope",
      "objective": "Permitir uma resposta geral sintetica quando general_allowed estiver explicito.",
      "tags": ["response_scope", "general_allowed"],
      "input": {
        "synthetic": true,
        "scenario": "general_question_allowed",
        "question": "Explique em termos gerais o que e uma fila de processamento.",
